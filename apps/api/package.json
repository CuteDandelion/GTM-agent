{
  "name": "@gtm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env.local watch src/main.ts",
    "dev:native-e2e": "tsx --env-file-if-exists=../../.env.local scripts/local-native-e2e-server.ts",
    "verify:native-e2e": "tsx --env-file-if-exists=../../.env.local scripts/verify-local-native-e2e.ts",
    "start": "tsx --env-file-if-exists=../../.env.local src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@gtm/agents": "0.1.0",
    "@gtm/contracts": "0.1.0",
    "@gtm/crawler": "0.1.0",
    "@gtm/documents": "0.1.0",
    "@gtm/orchestration": "0.1.0",
    "@gtm/tools": "0.1.0",
    "@opencode-ai/plugin": "^1.18.11",
    "@supabase/supabase-js": "2.111.0",
    "fastify": "5.11.0",
    "tsx": "4.23.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
