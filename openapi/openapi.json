{
  "openapi": "3.1.0",
  "info": {
    "title": "Conversational GTM Orchestrator API",
    "version": "0.1.0",
    "description": "Public HTTP contract for authenticated conversation, research-run, and interactive-object workflows."
  },
  "servers": [
    { "url": "/", "description": "Current deployment" }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "Service is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "service", "version"],
                  "properties": {
                    "status": { "const": "ok" },
                    "service": { "type": "string" },
                    "version": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Dependency readiness check",
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "503": { "$ref": "#/components/responses/JsonObject" }
        }
      }
    },
    "/api/v1/seller-profile": {
      "get": {
        "operationId": "getSellerProfile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "put": {
        "operationId": "upsertSellerProfile",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SellerProfileInput" } }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/conversations": {
      "post": {
        "operationId": "createConversation",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ConversationInput" } }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/JsonObject" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      },
      "get": {
        "operationId": "listConversations",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/JsonArray" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/conversations/{conversationId}": {
      "get": {
        "operationId": "getConversation",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ConversationId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/conversations/{conversationId}/messages": {
      "get": {
        "operationId": "listConversationMessages",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ConversationId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/JsonArray" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "sendConversationMessage",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ConversationId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/MessageInput" } }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "202": { "$ref": "#/components/responses/JsonObject" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/CapacityError" }
        }
      }
    },
    "/api/v1/conversations/{conversationId}/export": {
      "get": {
        "operationId": "exportConversation",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ConversationId" },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["json", "markdown"], "default": "json" }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation dossier",
            "content": {
              "application/json": { "schema": { "type": "object", "additionalProperties": true } },
              "text/markdown": { "schema": { "type": "string" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/conversations/{conversationId}/interactive-objects": {
      "get": {
        "operationId": "listInteractiveObjects",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ConversationId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/JsonArray" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/runs/{runId}": {
      "get": {
        "operationId": "getResearchRun",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/runs/{runId}/cancel": {
      "post": {
        "operationId": "cancelResearchRun",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/runs/{runId}/resume": {
      "post": {
        "operationId": "resumeResearchRun",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": {
          "202": { "$ref": "#/components/responses/JsonObject" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/CapacityError" }
        }
      }
    },
    "/api/v1/interactive-objects/{objectId}/actions": {
      "post": {
        "operationId": "applyInteractiveObjectAction",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ObjectActionInput" } }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObject" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "ConversationId": {
        "name": "conversationId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "RunId": {
        "name": "runId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "ObjectId": {
        "name": "objectId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "schemas": {
      "SellerProfileInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["businessName", "offerSummary", "capabilities", "proofPoints", "constraints"],
        "properties": {
          "businessName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "offerSummary": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "capabilities": {
            "type": "array",
            "maxItems": 50,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "proofPoints": {
            "type": "array",
            "maxItems": 50,
            "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
          },
          "constraints": { "type": "object", "additionalProperties": true }
        }
      },
      "ConversationInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "sellerProfileId": { "type": "string", "format": "uuid" },
          "icpDefinitionId": { "type": "string", "format": "uuid" }
        }
      },
      "MessageInput": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "domains": {
            "type": "array",
            "maxItems": 5,
            "default": [],
            "items": { "type": "string", "minLength": 1, "maxLength": 253 }
          },
          "documentIds": {
            "type": "array",
            "maxItems": 10,
            "default": [],
            "items": { "type": "string", "format": "uuid" }
          }
        }
      },
      "ObjectActionInput": {
        "type": "object",
        "required": ["action", "expectedVersion"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["challenge", "shortlist", "correct", "set_status", "respond"]
          },
          "expectedVersion": { "type": "integer", "minimum": 1 },
          "payload": { "type": "object", "default": {}, "additionalProperties": true }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" },
          "details": {},
          "retryAfterSeconds": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "responses": {
      "JsonObject": {
        "description": "JSON object response",
        "content": {
          "application/json": { "schema": { "type": "object", "additionalProperties": true } }
        }
      },
      "JsonArray": {
        "description": "JSON array response",
        "content": {
          "application/json": {
            "schema": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
          }
        }
      },
      "Error": {
        "description": "Request failed",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "CapacityError": {
        "description": "Capacity or request quota exceeded",
        "headers": {
          "Retry-After": { "schema": { "type": "integer", "minimum": 1 } }
        },
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      }
    }
  }
}
