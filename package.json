{
  "name": "conversational-gtm-orchestrator",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test tests/**/*.test.mjs",
    "test:database:contract": "node --test tests/database/*.test.mjs",
    "test:supabase:local": "node scripts/test-local-supabase.mjs",
    "dev:native-e2e-api": "npm run dev:native-e2e --workspace @gtm/api",
    "verify:native-e2e-api": "npm run verify:native-e2e --workspace @gtm/api",
    "eval:live": "tsx --env-file-if-exists=.env.local scripts/run-live-accuracy-eval.ts",
    "eval:grade": "tsx --env-file-if-exists=.env.local scripts/grade-live-accuracy-eval.ts",
    "eval:grade:precision": "tsx --env-file-if-exists=.env.local scripts/grade-generated-claim-accuracy-eval.ts",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "expo-router": "57.0.9",
    "inline-style-prefixer": "7.0.1",
    "postcss-value-parser": "4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-worklets": "0.10.1",
    "supabase": "2.111.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
